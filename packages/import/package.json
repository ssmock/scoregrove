{
  "name": "@scoregrove/import",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "import": "node --import ./scripts/register-resolver.mjs scripts/import.mjs",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.2",
    "@scoregrove/domain": "workspace:*"
  },
  "devDependencies": {
    "@scoregrove/engraving": "workspace:*",
    "@scoregrove/playback": "workspace:*",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
