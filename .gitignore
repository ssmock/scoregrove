# Imported scores are build artifacts — regenerate with
# `pnpm --filter @scoregrove/import run import`. The one committed exception is
# the theme fixture the stories render, which a test keeps in step.
packages/import/*.json
!packages/import/package.json
!packages/import/tsconfig*.json
